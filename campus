<script>
/* Un seul endroit à modifier pour les liens vers l'app. */
const SIGNUP_URL = "https://campus.legem.pro/auth"; // à remplacer par l'URL directe d'inscription si elle existe
const LOGIN_URL  = "https://campus.legem.pro/auth";

// Transmet les paramètres de campagne (utm_*) de cette page vers l'app :
// un étudiant arrivé par le QR du flyer reste attribué au flyer jusqu'à l'inscription.
const utm = new URLSearchParams();
new URLSearchParams(location.search).forEach((v, k) => { if (k.startsWith("utm_")) utm.set(k, v); });
function withUtm(url){
  if (![...utm.keys()].length) return url;
  const u = new URL(url); utm.forEach((v, k) => u.searchParams.set(k, v)); return u.toString();
}
document.querySelectorAll("[data-signup]").forEach(a => a.href = withUtm(SIGNUP_URL));
document.querySelectorAll("[data-login]").forEach(a => a.href = withUtm(LOGIN_URL));

// Exemple du hero : bascule Droit / Fiscalité
document.querySelectorAll(".switch button").forEach(b => b.addEventListener("click", () => {
  document.querySelectorAll(".switch button").forEach(x => x.setAttribute("aria-pressed", String(x === b)));
  document.getElementById("ex-droit").hidden = b.dataset.ex !== "droit";
  document.getElementById("ex-fisc").hidden  = b.dataset.ex !== "fisc";
}));
</script>
